[Unit]
Description=ChatWCA web interface for the Pi coding agent
Documentation=file:/home/adrian/projects/chatwca/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=adrian
WorkingDirectory=/home/adrian/projects/chatwca
Environment=NODE_ENV=production
EnvironmentFile=-/home/adrian/projects/chatwca/.env
ExecStart=/usr/bin/node /home/adrian/projects/chatwca/dist/server/server/index.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
KillMode=control-group
TasksMax=512
# Bubblewrap must create user/mount/PID/IPC/UTS/network namespaces itself.
PrivateUsers=false
RestrictNamespaces=false
KillSignal=SIGTERM
# ChatWCA caps graceful shutdown at 300s; allow a 10s manager margin.
TimeoutStopSec=310s
SyslogIdentifier=chatwca

[Install]
WantedBy=multi-user.target
