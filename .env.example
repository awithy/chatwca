# Copy to .env. Shell variables take precedence. Binding to loopback behind an
# authenticated mTLS reverse proxy is recommended; ChatWCA itself has no auth.
CHATWCA_HOST=127.0.0.1
CHATWCA_PORT=8787
CHATWCA_DATA_DIR=/var/lib/chatwca
CHATWCA_MAX_LIVE_CONVERSATIONS=8
CHATWCA_MAX_IMAGES=8
CHATWCA_MAX_IMAGE_BYTES=8388608
CHATWCA_MAX_TOTAL_IMAGE_BYTES=25165824
CHATWCA_SHUTDOWN_GRACE_MS=10000

# Process-global scheduled jobs. Run exactly one ChatWCA process for a given
# data/Pi state universe; SQLite is not multi-process scheduler leadership.
# Hook roots are startup-only, administrator-controlled canonical directories
# outside every workspace, mount, ChatWCA data directory, and Pi state/session
# directory. An empty list disables hooks but still permits jobs without
# scripts. Hooks use fixed `/usr/bin/bash -- <path>` arguments and run on the
# host with the service user's file/network authority, outside workspace
# sandbox and managed-egress restrictions. The service user needs read/search
# access to roots and scripts. See docs/jobs-operations.md before enabling.
CHATWCA_JOB_SCRIPT_ROOTS=[]
CHATWCA_JOB_HOOK_TIMEOUT_MS=300000
CHATWCA_JOB_HOOK_MAX_OUTPUT_BYTES=1048576

# Scheduled prompts run unattended and may incur provider costs or disclose
# readable workspace content to the configured model provider. Back up both
# CHATWCA_DATA_DIR and every Pi/default or workspace-local session store while
# ChatWCA is stopped; SQLite alone does not contain generated conversations.

# Workspace sandbox rollout: disabled, optional, or required. Required mode
# needs at least one canonical root. JSON values must be arrays of strings.
CHATWCA_SANDBOX_MODE=disabled
CHATWCA_BWRAP_PATH=/usr/bin/bwrap
CHATWCA_WORKSPACE_ROOTS=["/srv/chatwca/workspaces"]
CHATWCA_SANDBOX_RO_MOUNTS=[]
CHATWCA_SANDBOX_PATH=/usr/bin:/bin
CHATWCA_SANDBOX_START_TIMEOUT_MS=5000
CHATWCA_SANDBOX_COMMAND_TIMEOUT_MS=900000
CHATWCA_SANDBOX_MAX_COMMAND_OUTPUT_BYTES=67108864

# Managed egress remains disabled unless explicitly enabled. Optional mode also
# requires sandbox optional/required, a non-empty global destination ceiling,
# and a validated native helper. Allowing a destination permits tools to
# transmit any readable workspace content.
CHATWCA_MANAGED_EGRESS_MODE=disabled
# CHATWCA_NETWORK_HELPER_PATH=/opt/chatwca/bin/chatwca-network-helper
CHATWCA_NETWORK_ALLOWED_DOMAINS=[]
CHATWCA_NETWORK_DENIED_DOMAINS=[]
CHATWCA_NETWORK_ALLOWED_PORTS=[80,443]
# Named sets are administrator-owned exact subsets of the global domains/ports
# above. Leave this variable UNSET to synthesize "default" from the complete
# global ceiling (legacy single-policy compatibility). If set, the closed JSON
# array must contain exactly one "default" set; patterns are matched by exact
# normalized membership, not wildcard containment.
# CHATWCA_NETWORK_POLICY_SETS=[{"id":"default","label":"Package registries","allowedDomains":["registry.npmjs.org"],"allowedPorts":[443]},{"id":"github","label":"GitHub","allowedDomains":["**.github.com"],"allowedPorts":[443]}]
# To offer sandboxed access to any public web host, use "*" in both the global
# ceiling and selected set. Private/LAN/loopback/link-local/metadata addresses,
# global denies, and ports outside the set remain blocked.
# CHATWCA_NETWORK_ALLOWED_DOMAINS=["*"]
# CHATWCA_NETWORK_POLICY_SETS=[{"id":"default","label":"Open public web","allowedDomains":["*"],"allowedPorts":[80,443]}]
CHATWCA_NETWORK_MAX_CONNECTIONS=32
CHATWCA_NETWORK_CONNECT_TIMEOUT_MS=10000
CHATWCA_NETWORK_IDLE_TIMEOUT_MS=300000
CHATWCA_NETWORK_MAX_CONNECTION_BYTES=1073741824

# Optional Pi overrides. PI_OFFLINE is enabled by presence, even if set to 0;
# leave it unset for remote providers.
# PI_CODING_AGENT_DIR=/var/lib/chatwca/pi-agent
# PI_OFFLINE=1
